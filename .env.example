# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Client ID for slash command registration (required)
CLIENT_ID=your_client_id_here

# Guild ID for guild-specific slash commands (optional, for faster development)
GUILD_ID=

# Download settings
DOWNLOAD_DIR=./downloads
DOWNLOAD_RETRIES=5
AUTO_DOWNLOAD=true

# Backfill settings (0 = unlimited)
MAX_BACKFILL_DAYS=0

# Database path
DB_PATH=media_hashes.db

# MEGA credentials (optional — enables uploads after download)
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_ROOT=MediaDownloader
