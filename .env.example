# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Client ID for slash command registration (required)
CLIENT_ID=your_client_id_here

# Guild ID(s) for guild-specific slash commands (optional, for faster development)
# Comma-separate multiple guild IDs to register commands instantly in each
GUILD_ID=

# Download settings
DOWNLOAD_DIR=./downloads
DOWNLOAD_RETRIES=5
AUTO_DOWNLOAD=true

# Backfill settings (0 = unlimited)
MAX_BACKFILL_DAYS=0

# Database path
DB_PATH=media_hashes.db

# External drive (replaces MEGA when configured)
# Set the path and label to save downloads to an external drive instead of MEGA
EXTERNAL_DRIVE_PATH=H:\Discord\downloads
EXTERNAL_DRIVE_LABEL=BackUp

# MEGA credentials (optional — disabled when EXTERNAL_DRIVE_PATH is set)
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_ROOT=MediaDownloader

# Activity tracking
ADVANCED_TRACKING=false
SESSION_IDLE_MINUTES=5

# Connection retry settings
# Initial delay before retrying a failed connection (ms)
BOT_RETRY_BASE_MS=5000
# Maximum delay between retries (ms)
BOT_RETRY_MAX_MS=300000
# How long to wait for a login attempt before giving up and retrying (ms)
BOT_LOGIN_TIMEOUT_MS=45000

# Twitter/X author monitor (defaults to enabled)
# Set to false to disable the /monitor feature entirely
MONITOR_ENABLED=true

# How many statuses to fetch per poll (max 200, default 100)
MONITOR_PAGE_SIZE=100

# Max posts relayed per author per poll (default 25)
MONITOR_MAX_CATCHUP=25

# Text file with the hashtag list for the per-author hashtag filter
# One tag per line, '#' optional, lines starting with '# ' are comments
MONITOR_HASHTAG_FILE=monitor-hashtags.txt
